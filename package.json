{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "tsc": "tsc --noEmit",
        "lint:php": "vendor/bin/pint",
        "format:frontend": "prettier --write \"resources/**/*.{js,jsx,ts,tsx,json,css,md}\"",
        "format": "npm run format:frontend && npm run lint:php"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@types/lodash": "^4.17.26",
