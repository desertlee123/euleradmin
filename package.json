        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.6.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^1.3.0",
        "postcss": "^8.5.31",
        "prettier": "^2.8.8",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^6.4.4"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@headlessui/react": "^1.7.19",
        "@inertiajs/core": "^1.3.0",
        "@inertiajs/react": "^1.3.0",
