{
	admin localhost:2019
	auto_https off
	log {
		output stdout
		level ERROR
	}

	# FrankenPHP Worker mode for PRODUCTION
	# Mantiene Laravel en memoria entre requests (como Octane)
	# num_threads debe ser estrictamente mayor al total de worker threads.
	frankenphp {
		num_threads {$NUM_THREADS:2}
		worker {
			file /app/worker.php
			num {$NUM_WORKERS:1}
			env APP_ENV {$APP_ENV}
		}
	}
}

:80 {
	root * /app/public

	encode zstd br gzip

	php_server
	file_server

	@notStatic {
		not file
		not path /favicon.ico /robots.txt
	}
	rewrite @notStatic /index.php

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer-when-downgrade"
	}

	request_body {
		max_size 300MB
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
