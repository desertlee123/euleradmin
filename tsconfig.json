{
    "compilerOptions": {
        "target": "ESNext",
        "module": "preserve",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    },
    "include": ["./resources/js/**/*"]
}
